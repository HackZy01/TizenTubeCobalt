<resources>
<string name="url_hint">URLを入力してください</string>
    <string name="browser_process_initialization_failed">初期化に失敗しました。</string>
    <!-- Error message when there's a problem connecting to the network. -->
    <string name="starboard_platform_connection_error">現在接続できません</string>
    <!-- Button label on network connection error to retry the request. -->
    <string name="starboard_platform_retry">再試行</string>
    <!-- Button label on network connection error to open system network settings. -->
    <string name="starboard_platform_network_settings">ネットワーク設定を開く</string>
    <!-- Button label to dismiss an error message dialog. -->
    <string name="starboard_platform_dismiss">閉じる</string>
    <!-- Toast message when we can't get the device account to sign in. -->
    <string name="starboard_account_picker_error">アカウントを利用できません。</string>
    <!-- Toast message when we the account can't be authorized. -->
    <string name="starboard_account_auth_error">アカウントの認証に失敗しました。</string>
    <!-- Toast message indicating that the selected account is no longer available to sign-in. -->
    <string name="starboard_missing_account">アカウントを利用できません:\n%1$s</string>
    <!-- Toast message shown when the user has denied permission to get device accounts. -->
    <string name="starboard_accounts_permission">ログインするには、システム設定で連絡先へのアクセス権限を許可する必要があります。</string>	
